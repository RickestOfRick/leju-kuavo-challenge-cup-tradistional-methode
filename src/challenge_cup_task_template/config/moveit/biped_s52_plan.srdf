<?xml version="1.0"?>
<robot name="biped_s52">
  <virtual_joint name="virtual_fixed" type="fixed" parent_frame="odom" child_link="dummy_link"/>
  <!-- arms only: the legs are not planned for -->
  <group name="left_arm">
    <chain base_link="waist_yaw_link" tip_link="zarm_l7_end_effector"/>
  </group>
  <group name="right_arm">
    <chain base_link="waist_yaw_link" tip_link="zarm_r7_end_effector"/>
  </group>
  <group_state name="ready" group="left_arm">
    <joint name="zarm_l1_joint" value="0.5288"/>
    <joint name="zarm_l2_joint" value="0.0000"/>
    <joint name="zarm_l3_joint" value="0.1676"/>
    <joint name="zarm_l4_joint" value="-2.3946"/>
    <joint name="zarm_l5_joint" value="-1.5149"/>
    <joint name="zarm_l6_joint" value="-0.0506"/>
    <joint name="zarm_l7_joint" value="-0.0419"/>
  </group_state>
  <group_state name="ready" group="right_arm">
    <joint name="zarm_r1_joint" value="0.5271"/>
    <joint name="zarm_r2_joint" value="0.0000"/>
    <joint name="zarm_r3_joint" value="-0.1606"/>
    <joint name="zarm_r4_joint" value="-2.4155"/>
    <joint name="zarm_r5_joint" value="1.4207"/>
    <joint name="zarm_r6_joint" value="0.1396"/>
    <joint name="zarm_r7_joint" value="-0.0192"/>
  </group_state>
  <!-- without these a POSE goal is rejected ("only joint-space goals are
       supported") because the group has no declared end effector -->
  <end_effector name="left_ee" parent_link="zarm_l7_end_effector" group="left_arm"/>
  <end_effector name="right_ee" parent_link="zarm_r7_end_effector" group="right_arm"/>
  <!-- adjacent links are welded together; without these MoveIt reports
       self-collisions for every chain neighbour -->
  <disable_collisions link1="waist_yaw_link" link2="zarm_l1_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_l1_link" link2="zarm_l2_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_l2_link" link2="zarm_l3_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_l3_link" link2="zarm_l4_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_l4_link" link2="zarm_l5_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_l5_link" link2="zarm_l6_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_l6_link" link2="zarm_l7_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_l7_link" link2="zarm_l7_end_effector" reason="Adjacent"/>
  <disable_collisions link1="waist_yaw_link" link2="zarm_l7_end_effector" reason="Never"/>
  <disable_collisions link1="waist_yaw_link" link2="zarm_r1_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_r1_link" link2="zarm_r2_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_r2_link" link2="zarm_r3_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_r3_link" link2="zarm_r4_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_r4_link" link2="zarm_r5_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_r5_link" link2="zarm_r6_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_r6_link" link2="zarm_r7_link" reason="Adjacent"/>
  <disable_collisions link1="zarm_r7_link" link2="zarm_r7_end_effector" reason="Adjacent"/>
  <disable_collisions link1="waist_yaw_link" link2="zarm_r7_end_effector" reason="Never"/>
</robot>
